rules_version = '2';
// Prototype rules: emulator-tested; review before a broad launch.
// accounts/{uid}: cardId (UUID), createdAt (timestamp). Owner-only mapping; immutable.
// cards/{uuid}: ownerUid (1..128 chars), nickname (2..24), team enum,
// pokemon (int 1..1025), createdAt. Only profile fields may change.
// organizers/{uid}: enabled boolean. Provisioned only by trusted console/Admin SDK.
// events/{uuid}: title (3..100), place (3..160), date timestamp, year (2026..2100),
// slot (month-1..12/go-tour/go-fest/wild-area), createdBy UID, createdAt. Base fields immutable.
// Cancellation adds revoked=true, revokedBy UID, revokedAt timestamp, revocationReason (5..300).
// Cancellation is one-way, organizer-only and cannot alter the event base fields.
// cards/{uuid}/stampHistory/{eventId}: immutable copy of a cancelled stamp, written
// atomically only when a new valid stamp replaces it in the same annual slot.
// cards/{uuid}/stamps/{year_slot}: eventId UUID, year, slot, validatedBy UID,
// createdAt timestamp. One slot per year; only cancelled-event stamps may be replaced with an archive.
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
  function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
  function admin() { return signedIn() && exists(/databases/$(database)/documents/organizers/$(request.auth.uid)) && get(/databases/$(database)/documents/organizers/$(request.auth.uid)).data.enabled == true; }
  function text(v,min,max) { return v is string && v.size() >= min && v.size() <= max; }
  function uuid(v) { return v is string && v.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'); }
  function validYear(y) { return y is int && y >= 2026 && y <= 2100; }
  function validSlot(s) { return s in ['month-1','month-2','month-3','month-4','month-5','month-6','month-7','month-8','month-9','month-10','month-11','month-12','go-tour','go-fest','wild-area']; }
  function validCard(d) { return d.keys().hasAll(['ownerUid','nickname','team','pokemon','createdAt']) && d.keys().hasOnly(['ownerUid','nickname','team','pokemon','createdAt']) && text(d.ownerUid,1,128) && text(d.nickname,2,24) && d.team in ['Valor','Mystic','Instinct'] && d.pokemon is int && d.pokemon >= 1 && d.pokemon <= 1025 && d.createdAt is timestamp; }
  function ownsCard(id) { return signedIn() && exists(/databases/$(database)/documents/cards/$(id)) && get(/databases/$(database)/documents/cards/$(id)).data.ownerUid == request.auth.uid; }
  match /organizers/{uid} { allow get: if isOwner(uid); allow list, write: if false; }
  match /accounts/{uid} {
   allow get: if isOwner(uid);
   allow create: if isOwner(uid) && request.resource.data.keys().hasAll(['cardId','createdAt']) && request.resource.data.keys().hasOnly(['cardId','createdAt']) && uuid(request.resource.data.cardId) && request.resource.data.createdAt == request.time && getAfter(/databases/$(database)/documents/cards/$(request.resource.data.cardId)).data.ownerUid == uid;
   allow update, delete, list: if false;
  }
  match /cards/{cardId} {
   allow get: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
   allow list: if false;
   allow create: if uuid(cardId) && validCard(request.resource.data) && isOwner(request.resource.data.ownerUid) && request.resource.data.createdAt == request.time && !exists(/databases/$(database)/documents/accounts/$(request.auth.uid)) && getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.cardId == cardId;
   allow update: if isOwner(resource.data.ownerUid) && validCard(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','team','pokemon']);
   allow delete: if false;
   match /stamps/{stampId} {
    allow get, list: if ownsCard(cardId) || (admin() && exists(/databases/$(database)/documents/cards/$(cardId)));
    function validStamp(d) {
     let e = getAfter(/databases/$(database)/documents/events/$(d.eventId)).data;
     return e.get('revoked', false) == false && d.keys().hasAll(['eventId','year','slot','validatedBy','createdAt']) && d.keys().hasOnly(['eventId','year','slot','validatedBy','createdAt']) && uuid(d.eventId) && validYear(d.year) && validSlot(d.slot) && stampId == string(d.year) + '_' + d.slot && d.year == e.year && d.slot == e.slot && d.validatedBy == request.auth.uid && d.createdAt == request.time;
    }
    allow create: if admin() && exists(/databases/$(database)/documents/cards/$(cardId)) && validStamp(request.resource.data);
    allow update: if admin() && exists(/databases/$(database)/documents/cards/$(cardId))
      && validStamp(request.resource.data)
      && request.resource.data.eventId != resource.data.eventId
      && get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.get('revoked', false) == true
      && getAfter(/databases/$(database)/documents/cards/$(cardId)/stampHistory/$(resource.data.eventId)).data == resource.data;
    allow delete: if false;
   }
   match /stampHistory/{eventId} {
    allow get, list: if ownsCard(cardId) || (admin() && exists(/databases/$(database)/documents/cards/$(cardId)));
    function validArchive(d) {
     let stampId = string(d.year) + '_' + d.slot;
     let oldStamp = get(/databases/$(database)/documents/cards/$(cardId)/stamps/$(stampId)).data;
     let newStamp = getAfter(/databases/$(database)/documents/cards/$(cardId)/stamps/$(stampId)).data;
     return uuid(eventId) && d.eventId == eventId && d == oldStamp
       && get(/databases/$(database)/documents/events/$(eventId)).data.get('revoked', false) == true
       && newStamp.eventId != eventId;
    }
    allow create: if admin() && exists(/databases/$(database)/documents/cards/$(cardId)) && validArchive(request.resource.data);
    allow update, delete: if false;
   }
  }
  match /events/{eventId} {
   function validEvent(d) {
    return d.keys().hasAll(['title','place','date','year','slot','createdBy','createdAt'])
     && d.keys().hasOnly(['title','place','date','year','slot','createdBy','createdAt','revoked','revokedBy','revokedAt','revocationReason'])
     && text(d.title,3,100) && text(d.place,3,160) && d.date is timestamp
     && validYear(d.year) && d.year == d.date.year() && validSlot(d.slot)
     && (d.slot in ['go-tour','go-fest','wild-area'] || d.slot == 'month-' + string(d.date.month()))
     && text(d.createdBy,1,128) && d.createdAt is timestamp;
   }
   function validRevocation(d) {
    return !resource.data.keys().hasAny(['revoked','revokedBy','revokedAt','revocationReason'])
     && d.keys().hasAll(['revoked','revokedBy','revokedAt','revocationReason'])
     && d.diff(resource.data).affectedKeys().hasOnly(['revoked','revokedBy','revokedAt','revocationReason'])
     && d.revoked == true && text(d.revokedBy,1,128) && d.revokedBy == request.auth.uid
     && d.revokedAt == request.time && text(d.revocationReason,5,300);
   }
   allow get: if signedIn();
   allow list: if admin() && request.query.limit <= 200;
   allow create: if admin() && uuid(eventId) && validEvent(request.resource.data)
     && !request.resource.data.keys().hasAny(['revoked','revokedBy','revokedAt','revocationReason'])
     && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update: if admin() && uuid(eventId) && validEvent(request.resource.data) && validRevocation(request.resource.data);
   allow delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
